// 应用图标 + 版本信息。windres 用它编成 COFF 对象，
// 再由 build.rs 通过 cargo:rustc-link-arg-bins 交给链接器。
#pragma code_page(65001)

// 资源 ID 用 1：Windows 取最小 ID 的图标作为 exe 的默认图标。
1 ICON "icon.ico"

// VERSIONINFO：任务管理器「进程/应用」列表和文件属性里显示的名称、
// 公司、版本都来自这里。缺了这段，Windows 只能回退到文件名甚至
// 框架默认信息（看上去就像个 egui 示例程序）。
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "XINWEI"
            VALUE "FileDescription", "照片/视频时间修改工具"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "photo_time_fixer"
            VALUE "LegalCopyright", "Copyright (C) XINWEI. All rights reserved."
            VALUE "OriginalFilename", "photo_time_fixer.exe"
            VALUE "ProductName", "照片/视频时间修改工具"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
